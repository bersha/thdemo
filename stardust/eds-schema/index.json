  {
   "section": "th-section",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Våra försäkringar"
    },
    {
     "role": "heading",
     "order": 1,
     "text": "Bilförsäkring"
    },
    {
     "role": "body",
     "order": 2,
     "text": "Vår Bilförsäkring stor ligger i topp i jämförelse av svenska bilförsäkringar."
    },
    {
     "role": "cta",
     "order": 3,
     "text": "Läs om vår bilförsäkring",
     "href": "https://www.trygghansa.se/forsakringar/bilforsakring"
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Hemförsäkring"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Hemförsäkringar för alla sorters boenden. Upp till 1,5 miljoner i ersättning!"
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Se våra hemförsäkringar",
     "href": "https://www.trygghansa.se/forsakringar/hemforsakring"
    },
    {
     "role": "heading",
     "order": 7,
     "text": "Personförsäkringar"
    },
    {
     "role": "body",
     "order": 8,
     "text": "Skydd vid sjukdomar och olycksfall – för både barn och vuxna."
    },
    {
     "role": "cta",
     "order": 9,
     "text": "Se våra personförsäkringar",
     "href": "https://www.trygghansa.se/forsakringar/person"
    },
    {
     "role": "heading",
     "order": 10,
     "text": "Barnförsäkring"
    },
    {
     "role": "body",
     "order": 11,
     "text": "Vår barnförsäkring ger en trygg start i livet. Gäller tills 25 års ålder."
    },
    {
     "role": "cta",
     "order": 12,
     "text": "Läs om vår barnförsäkring",
     "href": "https://www.trygghansa.se/forsakringar/person/barnforsakring"
    },
    {
     "role": "heading",
     "order": 13,
     "text": "Gravidförsäkring"
    },
    {
     "role": "body",
     "order": 14,
     "text": "Ge ditt barn en trygg start! Vi har längst erfarenhet av gravidförsäkring i Sverige."
    },
    {
     "role": "cta",
     "order": 15,
     "text": "Läs om vår gravidförsäkring",
     "href": "https://www.trygghansa.se/forsakringar/gravidforsakring"
    },
    {
     "role": "heading",
     "order": 16,
     "text": "Livförsäkring"
    },
    {
     "role": "body",
     "order": 17,
     "text": "Ekonomiskt stöd till din familj, en trygghet om det värsta skulle hända."
    },
    {
     "role": "cta",
     "order": 18,
     "text": "Läs om livförsäkring",
     "href": "https://www.trygghansa.se/forsakringar/person/livforsakring"
    },
    {
     "role": "heading",
     "order": 19,
     "text": "Villaförsäkring"
    },
    {
     "role": "body",
     "order": 20,
     "text": "För dig som är husägare. Hjälp inom fyra timmar vid stora katastrofer."
    },
    {
     "role": "cta",
     "order": 21,
     "text": "Läs om vår villaförsäkring",
     "href": "https://www.trygghansa.se/forsakringar/hemforsakring/villaforsakring"
    },
    {
     "role": "heading",
     "order": 22,
     "text": "Djurförsäkring"
    },
    {
     "role": "body",
     "order": 23,
     "text": "Hitta försäkringen för hunden, katten eller för dig som är uppfödare."
    },
    {
     "role": "cta",
     "order": 24,
     "text": "Läs om våra djurförsäkringar",
     "href": "https://www.trygghansa.se/djurforsakring"
    },
    {
     "role": "heading",
     "order": 25,
     "text": "Fordonsförsäkringar"
    },
    {
     "role": "body",
     "order": 26,
     "text": "Bil, MC, moped eller släpvagn. Vi har fordonsförsäkringar för alla behov!"
    },
    {
     "role": "cta",
     "order": 27,
     "text": "Se våra fordonsförsäkringar",
     "href": "https://www.trygghansa.se/forsakringar/fordon"
    },
    {
     "role": "cta",
     "order": 28,
     "text": "Se alla våra försäkringar",
     "href": "https://www.trygghansa.se/forsakringar"
    }
   ],
