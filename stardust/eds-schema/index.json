  },
  {
   "section": "th-section",
   "items": [
    {
     "role": "heading",
     "order": 0,
     "text": "Rätt försäkringar för dig"
    },
    {
     "role": "body",
     "order": 1,
     "text": "Vi har rätt försäkring för dig, familjen, bilen och hemmet. Och för mycket mer, såklart."
    },
    {
     "role": "heading",
     "order": 2,
     "text": "Snart 200 år av trygghet"
    },
    {
     "role": "body",
     "order": 3,
     "text": "Trygg-Hansa har gjort skillnad i människors liv sedan 1828. Vi står stadigt vid din sida."
    },
    {
     "role": "heading",
     "order": 4,
     "text": "Upp till 20 % samlingsrabatt"
    },
    {
     "role": "body",
     "order": 5,
     "text": "Samla dina försäkringar hos oss och få upp till 20 % rabatt. ."
    },
    {
     "role": "cta",
     "order": 6,
     "text": "Läs mer om vår samlingsrabatt",
     "href": "https://www.trygghansa.se/forsakringar/samlingsrabatt"
    }
   ],
   "imgCount": 0,
   "editableTexts": 1,
   "repeats": [
    {
     "unitSelector": "LI.th-quick-facts-block__item",
     "count": 3,
     "unit": {
